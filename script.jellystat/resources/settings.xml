    <category id="display" label="32010">
      <group id="1">
        <setting id="show_percentages" type="boolean" label="32011">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_avg_ratings" type="boolean" label="32012">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_favourites" type="boolean" label="32013">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="show_list_ratings" type="boolean" label="32014">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="recent_days" type="integer" label="32015">
          <level>0</level>
          <default>30</default>
          <constraints>
            <minimum>7</minimum>
            <step>1</step>
            <maximum>90</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
            <heading>32015</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="dashboard" label="32040">
      <group id="1" label="32041">
        <setting id="web_enabled" type="boolean" label="32042">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <!-- A button, not a value: pops the dialog that shows the LAN
             address(es) to type into a browser. Lives here because this is
             where someone switching the dashboard on is already standing. -->
        <setting id="web_show_address" type="action" label="32049">
          <level>0</level>
          <data>RunScript(script.jellystat, dashboard_info)</data>
          <dependencies>
            <dependency type="enable" setting="web_enabled">true</dependency>
          </dependencies>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
        <setting id="web_port" type="integer" label="32043">
          <level>0</level>
          <default>8099</default>
          <dependencies>
            <dependency type="enable" setting="web_enabled">true</dependency>
          </dependencies>
          <constraints>
            <minimum>1024</minimum>
            <step>1</step>
            <maximum>65535</maximum>
          </constraints>
          <!-- popup: the row stays a button, so Left still returns to the
               category list. An inline slider swallows Left and Right. -->
          <control type="slider" format="integer">
            <popup>true</popup>
            <heading>32043</heading>
          </control>
        </setting>
        <setting id="web_bind_all" type="boolean" label="32044">
          <level>0</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable" setting="web_enabled">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <setting id="web_password" type="string" label="32045">
          <level>0</level>
          <default></default>
          <dependencies>
            <dependency type="enable" setting="web_enabled">true</dependency>
          </dependencies>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32045</heading>
            <hidden>true</hidden>
          </control>
        </setting>
        <setting id="web_cache_minutes" type="integer" label="32046">
          <level>0</level>
          <default>10</default>
          <dependencies>
            <dependency type="enable" setting="web_enabled">true</dependency>
          </dependencies>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>120</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
            <heading>32046</heading>
          </control>
        </setting>
      </group>
      <group id="2" label="32063">
        <setting id="rating_sets_favourite" type="boolean" label="32064">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="4" label="32047">
        <setting id="history_enabled" type="boolean" label="32048">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="playlog_enabled" type="boolean" label="32050">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="playlog_min_minutes" type="integer" label="32051">
          <level>0</level>
          <default>2</default>
          <dependencies>
            <dependency type="enable" setting="playlog_enabled">true</dependency>
          </dependencies>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>30</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
            <heading>32051</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="website" label="32020">
      <group id="1" label="32021">
        <!-- Written by the addon, never shown: which day's snapshot has
             already gone out, so a restart does not send a second one.
             Declared here because setSetting on an undeclared id relies on
             Kodi's undocumented handling of unknown settings, and if a
             version ever declines to keep it the snapshot would be re-sent
             on every five-minute service beat. -->
        <setting id="last_send_date" type="string" label="32022">
          <!-- 3 is Expert, the highest level Kodi defines; it is hidden
               outright below in any case. -->
          <level>3</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="label" format="string">
            <heading>32022</heading>
          </control>
          <visible>false</visible>
        </setting>
        <setting id="endpoint_url" type="string" label="32022">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32022</heading>
          </control>
        </setting>
        <setting id="site_token" type="string" label="32023">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32023</heading>
          </control>
        </setting>
      </group>
      <group id="2" label="32024">
        <setting id="send_when" type="integer" label="32025">
          <level>0</level>
          <default>1</default>
          <constraints>
            <options>
              <option label="32026">0</option>
              <option label="32027">1</option>
            </options>
          </constraints>
          <control type="list" format="integer">
            <heading>32025</heading>
          </control>
        </setting>
        <setting id="send_hour" type="integer" label="32028">
          <level>0</level>
          <default>18</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>23</maximum>
          </constraints>
          <!-- popup: the row stays a button, so Left still returns to the
               category list. An inline slider swallows Left and Right. -->
          <control type="slider" format="integer">
            <popup>true</popup>
            <heading>32028</heading>
          </control>
        </setting>
        <setting id="send_days" type="integer" label="32029">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="32030">0</option>
              <option label="32031">1</option>
              <option label="32032">2</option>
            </options>
          </constraints>
          <control type="list" format="integer">
            <heading>32029</heading>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
