<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="script.jellystat">
    <category id="server" label="32001">
      <group id="1" label="32002">
        <setting id="server_url" type="string" label="32003">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32003</heading>
          </control>
        </setting>
        <setting id="api_key" type="string" label="32004">
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32004</heading>
            <hidden>true</hidden>
          </control>
        </setting>
        <setting id="username" type="string" label="32005">
          <level>0</level>
          <default></default>
          <constraints>
