# Normalise line endings in the repository. Shell scripts must stay LF:
# CRLF has broken shebangs on a Pi and produced phantom diffs.
* text=auto
*.sh text eol=lf

# The superseded PowerShell script is kept for reference and stays CRLF.
*.ps1 text eol=crlf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.zip binary
